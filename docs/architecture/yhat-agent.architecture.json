  "cards": [
    {
      "dot": "cyan",
      "title": "Capture",
      "items": [
        "MCP tools: fts5_search, propose_memory, list_pending, get_memory, search_brain, share_memory",
        "propose_memory always writes status=proposed and takes the author from the operator config",
        "BR13 filter scans title, content and context, and masks the rejected secret"
      ]
    },
    {
      "dot": "emerald",
      "title": "Approval",
      "items": [
        "Bandeja binds 127.0.0.1 on a random port and guards every route with a one-shot token",
        "Approve validates, reject stores a reason, edit rewrites the record before re-validation",
        "Server shuts down after 15 idle minutes; the Enviados section shows rejections and their reason"
      ]
    },
    {
      "dot": "amber",
      "title": "Sharing",
      "items": [
        "share_memory requires a validated memory with share_status=none and enqueues into upload_queue",
        "Sync is FIFO by ordered_at, keeps a pull_cursor in sync_state and retries failures with backoff",
        "LocalDirTransport writes a central repo folder; HTTPTransport talks to F3 with a bearer token"
      ]
    },
    {
      "dot": "rose",
      "title": "Central and distribution",
      "items": [
        "F3 is a separate repository: 3-of-5 operator quorum, team roster, rejection reason at vote time",
        "Install copies the embedded OpenCode agent and skill, tracked by a SHA-256 manifest",
        "Update downloads from GitHub Releases, verifies the checksum, then writes a .yhat-agent-new candidate the operator renames by hand",
        "The WiX 3.14 per-user MSI runs yhat-agent install --no-bandeja and uninstall --yes"
      ]
    }
  ]
