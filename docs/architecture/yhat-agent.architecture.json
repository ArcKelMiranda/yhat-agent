  "cards": [
    {
      "dot": "cyan",
      "title": "Install",
      "items": [
        "Reads embedded assets from Go embed.FS",
        "Writes files exclusively using WriteExclusiveAtomically (O_CREATE|O_EXCL, single syscall, no TOCTOU window)",
        "Records SHA-256 hashes in manifest"
      ]
    },
    {
      "dot": "emerald",
      "title": "Drift handling",
      "items": [
        "Status compares installed file hash against manifest content_hash",
        "Uninstall refuses to remove files flagged as modified"
      ]
    },
    {
      "dot": "rose",
      "title": "Update",
      "items": [
        "Downloads from GitHub releases/latest/download/ (no API token)",
        "Verifies SHA-256 checksum before writing local side-by-side <name>.yhat-agent-new",
        "User applies the candidate manually by renaming it over the running binary",
        "Status command detects candidates by .yhat-agent-new suffix in standard dirs"
      ]
    }
